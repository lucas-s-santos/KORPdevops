    {
      "id": 9,
      "type": "timeseries",
      "title": "Taxa de erro (5xx e 4xx)",
      "description": "Proporção de respostas com erro sobre o total. Base para um SLO de sucesso. clamp_min evita divisão por zero quando não há tráfego.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
