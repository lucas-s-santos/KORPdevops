          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(korp_http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(korp_http_requests_total[$__rate_interval])), 0.0001)",
