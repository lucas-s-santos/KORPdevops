# Copie para .env e ajuste conforme necessário.
# O Compose lê este arquivo automaticamente.

APP_VERSION=1.0.0
APP_COMMIT=local
APP_BUILD_DATE=1970-01-01T00:00:00Z

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# URL do webhook do Discord que recebe as notificações de alerta.
#
# Deixar vazio é um estado válido e é o padrão: sem ela o alerta continua
# virando log estruturado e métrica no notificador, e nada quebra. É assim
# que o CI roda, sem precisar de credencial.
#
# Para criar: no Discord, Configurações do canal > Integrações > Webhooks.
# O .env está no .gitignore — a URL não vai para o Git.
DISCORD_WEBHOOK_URL=
